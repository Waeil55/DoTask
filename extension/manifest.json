{
  "manifest_version": 3,
  "name": "DoTask AI — Teach, Study & Do",
  "short_name": "DoTask",
  "version": "2.0.0",
  "description": "AI assistant in your browser: grades Canvas work with you, keeps every student's feedback, tutors by voice, writes replies and runs web tasks with your permission.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open DoTask (Alt+Shift+D)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "unlimitedStorage",
    "tabs",
    "scripting",
    "activeTab",
    "contextMenus",
    "webNavigation"
  ],
  "optional_permissions": [
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Open DoTask"
    }
  },
  "storage": {
    "managed_schema": "managed_schema.json"
  }
}
