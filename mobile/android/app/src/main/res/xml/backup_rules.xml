<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 6-11 (API 23-30) Auto Backup rules. android:allowBackup="false" already
  turns backup off; this file is a second guard in case that flag is ever flipped:
  nothing from the app (student records, Keystore-wrapped secrets) may be backed up.
  Android 12+ uses data_extraction_rules.xml instead.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
