<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Used by .github/workflows/ios.yml (xcodebuild -exportArchive).
  - app-store-connect + destination upload: export signs the archive for distribution and
    uploads it straight to App Store Connect / TestFlight (no Transporter, no Mac needed).
  - signingStyle automatic: Xcode cloud-managed signing via the App Store Connect API key.
  - teamID: placeholder; CI writes secrets.APPLE_TEAM_ID into a temporary copy with PlistBuddy,
    so the team ID never has to live in the repository.
  - manageAppVersionAndBuildNumber false: CI already sets the build number (run number) and
    MARKETING_VERSION comes from the project; Xcode must not rewrite them on upload.
-->
<plist version="1.0">
<dict>
	<key>destination</key>
	<string>upload</string>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
	<key>method</key>
	<string>app-store-connect</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>teamID</key>
	<string>REPLACED_BY_CI</string>
	<key>uploadSymbols</key>
	<true/>
</dict>
</plist>
