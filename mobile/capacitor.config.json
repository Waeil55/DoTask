{
  "appId": "com.agapecare.dotask",
  "appName": "DoTask",
  "webDir": "www",
  "loggingBehavior": "debug",
  "backgroundColor": "#f7f7fb",
  "ios": {
    "contentInset": "never",
    "scheme": "DoTask"
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "CapacitorHttp": { "enabled": false },
    "SplashScreen": { "launchShowDuration": 500, "launchAutoHide": true, "backgroundColor": "#f7f7fb", "showSpinner": false },
    "Keyboard": { "resize": "body", "resizeOnFullScreen": true }
  }
}
